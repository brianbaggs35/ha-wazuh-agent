root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_size = 4

[{wazuh_agent/rootfs/usr/local/bin/*,wazuh_agent/rootfs/usr/local/lib/wazuh-ha/{hostns-start,restart-wazuh}}]
indent_size = 4

[Makefile]
indent_style = tab
