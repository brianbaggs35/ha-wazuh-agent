{
  "manager_address": "wazuh.example.lan",
  "manager_port": 1514,
  "manager_protocol": "udp",
  "manager_failover_addresses": ["wazuh2.example.lan", "10.0.0.9"],
  "server_max_retries": 7,
  "server_retry_interval": 15,
  "notify_time": 30,
  "time_reconnect": 90,
  "crypto_method": "aes",
  "auto_restart": false,
  "config_profile": "homeassistant, custom",
  "buffer_enabled": true,
  "buffer_queue_size": 8000,
  "buffer_events_per_second": 300,
  "enrollment_enabled": true,
  "enrollment_address": "enroll.example.lan",
  "enrollment_port": 1516,
  "enrollment_password": "s3cret-with-<angle>-ok",
  "enrollment_ca_path": "/config/ca.pem",
  "enrollment_certificate_path": "/config/agent.pem",
  "enrollment_key_path": "/config/agent.key",
  "enrollment_delay": 5,
  "enrollment_use_source_ip": true,
  "agent_name": "ha-living-room",
  "agent_groups": ["homeassistant", "iot"],
  "auto_labels": true,
  "agent_labels": [{"key": "site", "value": "home"}, {"key": "ha_arch", "value": "overridden"}],
  "journal_enabled": true,
  "journal_auth": true,
  "journal_kernel": false,
  "journal_homeassistant": true,
  "journal_supervisor": false,
  "journal_errors": false,
  "journal_apps": true,
  "journal_all": false,
  "journal_filters": [{"field": "SYSLOG_IDENTIFIER", "pattern": "^addon_core_mosquitto$", "ignore_if_missing": true}],
  "ha_core_log_enabled": true,
  "log_files": [
    {"path": "/share/myapp/*.log", "format": "json", "only_future_events": false, "ignore": "debug\\d+", "restrict": "error|fail", "exclude": "*.gz", "age": "7d"},
    {"path": "/share/plain.log"}
  ],
  "log_commands": [
    {"command": "df -P", "format": "command", "frequency": 600, "alias": "disk usage"},
    {"command": "uptime"}
  ],
  "fim_enabled": true,
  "fim_frequency": 3600,
  "fim_scan_on_start": false,
  "fim_directories": [
    {"path": "/homeassistant", "realtime": true, "report_changes": false, "check_all": true, "restrict": "\\.yaml$", "tags": "ha-config", "recursion_level": 4},
    {"path": "/ssl"}
  ],
  "fim_ignore": ["/homeassistant/www"],
  "fim_ignore_sregex": ["\\.bak$"],
  "fim_nodiff": ["/homeassistant/secrets.yaml"],
  "fim_nodiff_sregex": ["^/ssl/"],
  "fim_max_eps": 100,
  "fim_process_priority": 5,
  "fim_file_limit": 50000,
  "fim_sync_enabled": false,
  "fim_sync_interval": "10m",
  "fim_sync_max_eps": 20,
  "rootcheck_enabled": true,
  "rootcheck_frequency": 21600,
  "rootcheck_check_files": true,
  "rootcheck_check_trojans": false,
  "rootcheck_check_dev": true,
  "rootcheck_check_sys": false,
  "rootcheck_check_pids": true,
  "rootcheck_check_ports": true,
  "rootcheck_check_if": false,
  "sca_enabled": true,
  "sca_scan_on_start": false,
  "sca_interval": "1d",
  "sca_skip_nfs": false,
  "sca_policies": ["ruleset/sca/cis_debian13.yml"],
  "inventory_enabled": true,
  "inventory_interval": "30m",
  "inventory_scan_on_start": false,
  "inventory_hardware": true,
  "inventory_os": false,
  "inventory_network": true,
  "inventory_packages": true,
  "inventory_ports": true,
  "inventory_processes": true,
  "active_response_enabled": true,
  "allow_remote_commands": true,
  "debug_level": 2,
  "log_max_size_mb": 20
}
