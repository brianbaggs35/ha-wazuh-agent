#!/usr/bin/env bash
# shellcheck shell=bash
# ==============================================================================
# Runs the Wazuh agent against the Home Assistant OS host instead of against this app's container.
#
#   wazuh-ha-host facts          JSON: which scope applies, why (if not the one asked for), and where
#                                this container's folders are on the host
#   wazuh-ha-host path PATH      where PATH (a path in this container) is on the host
#   wazuh-ha-host start          start the agent daemons inside the host's mount namespace
#   wazuh-ha-host core-python    keep the links to the Python packages of Home Assistant Core and of the
#                                Supervisor current
#   wazuh-ha-host python-pid MODULE
#                                the PID of the process started as `python3 [options] -m MODULE`, if any
#
# Why
# ---
# An app is a container, so a Wazuh agent started in it sees the container: its files, its
# operating system, its packages. Installing the agent "on the Home Assistant OS device" is not
# possible (the host is a read-only image with no package manager), so the agent is started from
# here but run inside the host's own mount namespace, where /etc/os-release, /proc, the journal,
# /mnt/data and every other path is the host's.
#
# That needs three things, all of which Home Assistant grants an app only when it asks:
#   * the host's process namespace (host_pid), allowed only while Protection mode is off, so the
#     host's init is visible here and its namespaces can be joined;
#   * the SYS_PTRACE capability, to read the namespaces of a process that holds more privileges
#     than this container (the kernel refuses otherwise, whatever the user ID);
#   * the SYS_ADMIN capability, to join a mount namespace and to build the small private overlay
#     (see hostns-start) that gives the agent its "wazuh" account and a CPU name.
# The host's network and host name come from the app manifest (host_network, host_uts).
#
# Exit status of `start`: 0 started; 3 host access is not available; 4 the agent cannot run in
# the host's userland; 5 the agent rejected its configuration.
# ==============================================================================
set -uo pipefail

readonly LIB="${WAZUH_HA_LIB:-/usr/local/lib/wazuh-ha}"
readonly OPTIONS="${OPTIONS_FILE:-/data/options.json}"
readonly DATA="${WAZUH_HA_DATA:-/data}"
readonly OSSEC="${WAZUH_HA_OSSEC:-/var/ossec}"
# 1 is the host's init. Only the tests point this at another process (a stand-in for the host), and
# at a /proc/cpuinfo and a device tree model of their own (WAZUH_HA_CPUINFO, WAZUH_HA_BOARD_FILE).
readonly HOST_PID="${WAZUH_HA_HOST_PID:-1}"
# Where the table of processes is read when looking for Home Assistant's programs. Only the tests point this
# at a table of their own (one directory per PID, each with the command line the kernel would show).
readonly PROC="${WAZUH_HA_PROC:-/proc}"
readonly HOST_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# In the order wazuh-control starts them.
readonly DAEMONS=(wazuh-execd wazuh-agentd wazuh-syscheckd wazuh-logcollector wazuh-modulesd)
# Where Home Assistant mounts an app's folders, whichever of them this app asked for.
readonly CONTAINER_FOLDERS=(/data /config /homeassistant /ssl /share /media /backup /addons /addon_configs)

# The scope the user asked for. Host monitoring is the default; only an explicit false turns it off
# (jq's // would also replace false by the default).
requested_scope() {
    jq -r 'if .monitor_host == false then "container" else "host" end' "${OPTIONS}" 2> /dev/null || echo host
    return 0
}

# The capabilities host access needs and this container lacks, one per line.
missing_capabilities() {
    local effective entry held
    effective="$(awk '/^CapEff:/ {print $2}' /proc/self/status 2> /dev/null)"
    : "${effective:=0}"
    for entry in SYS_CHROOT:18 SYS_PTRACE:19 SYS_ADMIN:21; do
        # The capability's bit in the effective set (capability(7) numbers them).
        held=$(((16#${effective} >> ${entry##*:}) & 1))
        if [[ "${held}" -eq 0 ]]; then
            printf '%s\n' "${entry%%:*}"
        fi
    done
    return 0
}

# Can this container see the host's mount namespace? It can when the host's init (or, in the tests,
# the stand-in) is a process that is not in this container's own namespace.
host_namespace_reachable() {
    local mine theirs
    mine="$(readlink /proc/self/ns/mnt 2> /dev/null)" || return 1
    theirs="$(readlink "/proc/${HOST_PID}/ns/mnt" 2> /dev/null)" || return 1
    [[ -n "${theirs}" && "${theirs}" != "${mine}" ]]
    return
}

# What the Supervisor says about this app's protection mode: true, false or unknown.
supervisor_protection() {
    local answer=""
    if [[ -n "${SUPERVISOR_TOKEN:-}" ]]; then
        answer="$(curl -fsS --max-time 10 -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            http://supervisor/addons/self/info 2> /dev/null \
            | jq -r '.data.protected | if . == null then "unknown" else tostring end' 2> /dev/null)"
    fi
    echo "${answer:-unknown}"
    return 0
}

# host_path PATH -> where PATH of this container is on the host (see hostpath.awk)
host_path() {
    local path="$1"
    awk -v want="${path}" -f "${LIB}/hostpath.awk" /proc/self/mountinfo "/proc/${HOST_PID}/mountinfo"
    return
}

# The container's folders that exist here, each with its path on the host: {"/data": "/mnt/data/..."}
folder_map() {
    local folder host map="{}"
    for folder in "${CONTAINER_FOLDERS[@]}"; do
        mountpoint -q "${folder}" 2> /dev/null || continue
        host="$(host_path "${folder}")" || continue
        map="$(jq -c --arg folder "${folder}" --arg host "${host}" '. + {($folder): $host}' <<< "${map}")"
    done
    printf '%s\n' "${map}"
    return 0
}

facts() {
    local requested mode reason="" message="" missing protection mounts="{}"
    requested="$(requested_scope)"
    mode="${requested}"

    if [[ "${requested}" == host ]]; then
        missing="$(missing_capabilities | paste -sd, -)"
        if [[ -n "${missing}" ]]; then
            mode=unavailable
            reason=missing_capabilities
            message="This app is missing the Linux capabilities ${missing//,/, }, which Home Assistant grants only to an app that declares them. Update the app, and check that it was not started with other privileges."
        elif ! host_namespace_reachable; then
            mode=unavailable
            protection="$(supervisor_protection)"
            case "${protection}" in
                true)
                    reason=protection_mode
                    message="Protection mode is on. Monitoring the Home Assistant OS host needs this app to share the host's process namespace, which Home Assistant allows only while Protection mode is off. Open this app's Info tab, turn Protection mode off, then restart the app. To monitor only this app's own container instead, set monitor_host to false."
                    ;;
                false)
                    reason=restart_needed
                    message="Protection mode is off, but this app is still running without access to the host. Restart the app."
                    ;;
                *)
                    reason=no_host_pid
                    message="This app does not share the host's process namespace, so the host cannot be reached. Home Assistant shares it only while Protection mode is off."
                    ;;
            esac
        else
            mounts="$(folder_map)"
        fi
    fi

    jq -cn --arg requested "${requested}" --arg mode "${mode}" --arg reason "${reason}" \
        --arg message "${message}" --argjson pid "${HOST_PID}" --argjson mounts "${mounts}" \
        '{requested: $requested, mode: $mode, available: ($mode != "unavailable"), reason: $reason,
          message: $message, host_pid: $pid, mounts: $mounts}'
    return 0
}

# --- The Python packages of Home Assistant's own programs -------------------------

# Home Assistant OS has no package manager, so the host itself has nothing for Wazuh's vulnerability
# detection to match. What the device runs is mostly Home Assistant Core and the Supervisor, Python
# applications whose dependencies Wazuh does have advisories for (PyPI, through OSV). Each is a container
# of its own, so its Python packages are in its file system, not the host's; but the app shares the host's
# process namespace, and a process of a container shows that container's file system as /proc/PID/root.
#
# Wazuh reads Python packages only from fixed places (/home/*/.local/lib/python*/*-packages is one), so
# hostns-start gives the agent a /home with one such place for each program, linked to
# ${DATA}/hostview/LINK. The links below are what those point at. A link names a PID, and a program gets a
# new one every time it restarts, so the links are kept current from outside (the supervisor calls this
# every few seconds) and the agent never has to be restarted for it.
#
# LINK:MODULE:NAME. LINK is the link's name, and with MODULE (the program is started as python3 -m MODULE,
# see the run scripts of the two containers) the user whose home the place is in. NAME is what the log calls it.
readonly PYTHON_PROGRAMS=(
    "corepython:homeassistant:Home Assistant Core"
    "supervisorpython:supervisor:Home Assistant Supervisor"
)

# The PID of a process started as `python3 [options] -m MODULE ...`, or nothing.
#
# What stands between the interpreter and -m is not fixed: Home Assistant's own container ran
# `python3 -m homeassistant` until 2026.8 and runs `python3 -P -m homeassistant` since 2026.9. So the command
# line is read the way Python reads it: options first (the few that take a value are skipped with it), and
# the first -m names the module that runs. What follows the module belongs to the program.
#
# Only builtins read it: this looks at every process of the device, every few seconds while a program is not there.
python_module_pid() {
    local module="$1" cmdline interpreter i arg pid
    local -a args
    for cmdline in "${PROC}"/[0-9]*/cmdline; do
        # A process that has just exited has no command line to read, and a kernel thread has an empty one.
        { mapfile -d '' -t args < "${cmdline}"; } 2> /dev/null || continue
        interpreter="${args[0]:-}"
        interpreter="${interpreter##*/}"
        [[ "${interpreter}" == python || "${interpreter}" == python3 || "${interpreter}" == python3.* ]] || continue
        i=1
        while ((i < ${#args[@]})); do
            arg="${args[i]}"
            if [[ "${arg}" == -m || "${arg}" =~ ^-[BbdEIiOPqRSsuvx]+m$ ]]; then
                # -m, alone or after options that take no value (-Pm, -um): the next word is the module.
                if [[ "${args[i + 1]:-}" == "${module}" ]]; then
                    pid="${cmdline#"${PROC}"/}"
                    printf '%s\n' "${pid%/cmdline}"
                    return 0
                fi
                break
            elif [[ "${arg}" == -W || "${arg}" == -X || "${arg}" == --check-hash-based-pycs ]]; then
                i=$((i + 2))
            elif [[ "${arg}" == -c || "${arg}" != -* ]]; then
                # A command or a script: the program is not started as a module.
                break
            else
                i=$((i + 1))
            fi
        done
    done
    return 1
}

# Where in the file system of the process PID its Python packages are, or nothing. Both are where the official
# Python images, which Home Assistant's containers are built on, and Alpine's own Python keep them.
python_site_packages() {
    local pid="$1" pattern found
    for pattern in "/usr/local/lib/python3*/site-packages" "/usr/lib/python3*/site-packages"; do
        found="$(compgen -G "${PROC}/${pid}/root${pattern}" | head -n 1)"
        if [[ -n "${found}" ]]; then
            printf '%s\n' "${found}"
            return 0
        fi
    done
    return 1
}

# Whether the Python packages of Home Assistant's programs are to be inventoried: on unless the option says
# otherwise (jq's // would also replace false by the default).
core_python_enabled() {
    jq -e '.inventory_core_packages != false' "${OPTIONS}" > /dev/null 2>&1
    return
}

# note LINK MESSAGE: says what happened to a program, once. The app log should tell a user why the packages of
# Home Assistant Core are missing from the inventory, without saying it again every few seconds.
note() {
    local message="$2" state="${DATA}/hostview/$1.state"
    [[ "$(cat "${state}" 2> /dev/null)" == "${message}" ]] && return 0
    printf '%s\n' "${message}" > "${state}"
    printf '%s\n' "${message}"
    return 0
}

core_python() {
    local view="${DATA}/hostview" marker="${DATA}/hostview/pythonpackages.enabled" entry link module name pid packages
    # The marker of version 1.0.3, from before the Supervisor's packages were inventoried too.
    rm -f "${view}/corepython.enabled"
    if ! core_python_enabled || [[ ! -d "${view}" ]]; then
        for entry in "${PYTHON_PROGRAMS[@]}"; do
            rm -f "${view}/${entry%%:*}" "${view}/${entry%%:*}.state"
        done
        rm -f "${marker}"
        return 0
    fi
    # The marker says that the packages are wanted, and tells hostns-start which links to give the agent.
    for entry in "${PYTHON_PROGRAMS[@]}"; do
        IFS=: read -r link module name <<< "${entry}"
        printf '%s:%s\n' "${link}" "${module}"
    done > "${marker}"
    for entry in "${PYTHON_PROGRAMS[@]}"; do
        IFS=: read -r link module name <<< "${entry}"
        # Still pointing at a live program: nothing to do.
        [[ -d "${view}/${link}" ]] && continue
        rm -f "${view}/${link}"
        if ! pid="$(python_module_pid "${module}")"; then
            note "${link}" "${name} is not among the device's processes: its Python packages are not in the inventory while it is not running."
            continue
        fi
        if ! packages="$(python_site_packages "${pid}")"; then
            note "${link}" "${name} (process ${pid}) has no Python packages where they are expected (python3*/site-packages in /usr/local/lib or /usr/lib): they are not in the inventory."
            continue
        fi
        ln -sfn "${packages}" "${view}/${link}"
        note "${link}" "${name} (process ${pid}): its Python packages are in the inventory."
    done
    return 0
}

# --- start ------------------------------------------------------------------

# Copies of the host's account files with the "wazuh" account added, for hostns-start to lay over
# the originals inside the private namespace.
write_account_file() {
    local name="$1" line="$2"
    local source="/proc/${HOST_PID}/root/etc/${name}" target="${DATA}/hostview/${name}"
    if [[ ! -r "${source}" ]]; then
        echo "cannot read the host's /etc/${name}" >&2
        return 1
    fi
    {
        cat "${source}"
        # A file that does not end in a newline would swallow the line added after it.
        [[ -z "$(tail -c 1 "${source}")" ]] || echo
        grep -q '^wazuh:' "${source}" || printf '%s\n' "${line}"
    } > "${target}.tmp" && mv -f "${target}.tmp" "${target}"
    return
}

# A /proc/cpuinfo that names the CPU, for kernels (ARM) whose own does not. None when it already does.
write_cpuinfo() {
    local source="${WAZUH_HA_CPUINFO:-/proc/cpuinfo}" target="${DATA}/hostview/cpuinfo" board="" name
    local board_file="${WAZUH_HA_BOARD_FILE:-/proc/device-tree/model}"
    rm -f "${target}" "${target}.tmp"
    if [[ -r "${board_file}" ]]; then
        board="$(tr -d '\0' < "${board_file}")"
    fi
    name="$(awk -v board="${board}" -v arch="$(uname -m)" -f "${LIB}/cpuname.awk" "${source}")"
    if [[ -n "${name}" ]]; then
        { cat "${source}"; printf 'model name\t: %s\n' "${name}"; } > "${target}.tmp" && mv -f "${target}.tmp" "${target}"
    fi
    return 0
}

prepare() {
    local hostdata="$1"
    install -d -m 0755 "${DATA}/hostbin" "${DATA}/hostview" || return 1
    install -m 0755 "$(command -v busybox)" "${DATA}/hostbin/busybox" || return 1
    install -m 0755 "${LIB}/hostns-start" "${DATA}/hostbin/hostns-start" || return 1
    write_account_file passwd "wazuh:x:$(id -u wazuh):$(id -g wazuh):Wazuh agent:/var/ossec:/sbin/nologin" || return 1
    write_account_file group "wazuh:x:$(id -g wazuh):" || return 1
    write_cpuinfo
    # What the last run said about Home Assistant's programs was about that run: say it again in this one.
    rm -f "${DATA}/hostview/"*.state
    core_python
    echo "The agent will run in the host's file system; its files are at ${hostdata}/ossec on the host."
    return 0
}

# Can the agent run in the host's userland at all? Starting one daemon with -V loads it and every
# library it needs through the host's own dynamic loader, which is exactly what could go wrong.
probe() {
    local hosthome="$1" output
    if ! output="$(env -i PATH="${HOST_PATH}" "$(command -v nsenter)" --target "${HOST_PID}" --mount -- \
        "${hosthome}/bin/wazuh-agentd" -V 2>&1)"; then
        printf '%s\n' "${output}" >&2
        return 1
    fi
    return 0
}

# The same check wazuh-control makes before it starts anything: every daemon accepts the configuration.
test_configuration() {
    local daemon output
    for daemon in "${DAEMONS[@]}"; do
        if ! output="$("${OSSEC}/bin/${daemon}" -t 2>&1)"; then
            printf '%s\n' "${output}" >&2
            return 1
        fi
    done
    return 0
}

launch() {
    local hostdata="$1" hosthome="$2" busybox="$1/hostbin/busybox" pidfile
    # What wazuh-control clears before a start: temporary files, and PID files of daemons that are gone.
    rm -rf "${OSSEC:?}/tmp/"*
    for pidfile in "${OSSEC}"/var/run/wazuh-*.pid; do
        [[ -e "${pidfile}" ]] || continue
        kill -0 "$(cat "${pidfile}")" 2> /dev/null || rm -f "${pidfile}"
    done
    env -i PATH="${HOST_PATH}" LANG=C "$(command -v nsenter)" --target "${HOST_PID}" --mount -- \
        "${busybox}" unshare --mount -- \
        "${busybox}" sh "${hostdata}/hostbin/hostns-start" "${busybox}" "${hosthome}" "${hostdata}/hostview" "${DAEMONS[@]}"
    return
}

start() {
    local hostdata state
    state="$(facts)"
    if [[ "$(jq -r .mode <<< "${state}")" != host ]]; then
        echo "host access is not available: $(jq -r .message <<< "${state}")" >&2
        return 3
    fi
    hostdata="$(host_path "${DATA}")" || {
        echo "cannot work out where ${DATA} is on the host" >&2
        return 3
    }
    prepare "${hostdata}" || return 3
    probe "${hostdata}/ossec" || return 4
    test_configuration || return 5
    launch "${hostdata}" "${hostdata}/ossec"
    return
}

main() {
    case "${1:-}" in
        facts) facts ;;
        path) host_path "${2:?usage: wazuh-ha-host path PATH}" ;;
        start) start ;;
        core-python) core_python ;;
        python-pid) python_module_pid "${2:?usage: wazuh-ha-host python-pid MODULE}" ;;
        *)
            echo "usage: wazuh-ha-host facts | path PATH | start | core-python | python-pid MODULE" >&2
            return 1
            ;;
    esac
    return
}

main "$@"
