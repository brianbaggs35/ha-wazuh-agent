<!--
  Generated by the Home Assistant "Wazuh Agent" app from its Configuration tab.
  Do not edit: this file is rewritten every time the app starts.
  To add anything this app has no option for, put extra <ossec_config> blocks
  in ossec_extra.conf in the app's configuration folder.
-->
<ossec_config>
  <client>
{{- range .servers }}
    <server>
      <address>{{ .address }}</address>
      <port>{{ .port }}</port>
      <protocol>{{ .protocol }}</protocol>
      <max_retries>{{ $.client.max_retries }}</max_retries>
      <retry_interval>{{ $.client.retry_interval }}</retry_interval>
    </server>
{{- end }}
{{- if .client.config_profile }}
    <config-profile>{{ .client.config_profile }}</config-profile>
{{- end }}
    <notify_time>{{ .client.notify_time }}</notify_time>
    <time-reconnect>{{ .client.time_reconnect }}</time-reconnect>
    <auto_restart>{{ .client.auto_restart }}</auto_restart>
    <crypto_method>{{ .client.crypto_method }}</crypto_method>
    <enrollment>
      <enabled>{{ .enrollment.enabled }}</enabled>
{{- if .enrollment.address }}
      <manager_address>{{ .enrollment.address }}</manager_address>
{{- end }}
      <port>{{ .enrollment.port }}</port>
      <agent_name>{{ .enrollment.agent_name }}</agent_name>
{{- if .enrollment.groups }}
      <groups>{{ .enrollment.groups }}</groups>
{{- end }}
{{- if .enrollment.ca_path }}
      <server_ca_path>{{ .enrollment.ca_path }}</server_ca_path>
{{- end }}
{{- if .enrollment.certificate_path }}
      <agent_certificate_path>{{ .enrollment.certificate_path }}</agent_certificate_path>
      <agent_key_path>{{ .enrollment.key_path }}</agent_key_path>
{{- end }}
{{- if .enrollment.use_password }}
      <authorization_pass_path>etc/authd.pass</authorization_pass_path>
{{- end }}
      <delay_after_enrollment>{{ .enrollment.delay }}</delay_after_enrollment>
      <use_source_ip>{{ .enrollment.use_source_ip }}</use_source_ip>
    </enrollment>
  </client>

  <client_buffer>
    <disabled>{{ .buffer.disabled }}</disabled>
    <queue_size>{{ .buffer.queue_size }}</queue_size>
    <events_per_second>{{ .buffer.events_per_second }}</events_per_second>
  </client_buffer>

  <!-- Policy monitoring -->
  <rootcheck>
    <disabled>{{ .rootcheck.disabled }}</disabled>
    <check_files>{{ .rootcheck.check_files }}</check_files>
    <check_trojans>{{ .rootcheck.check_trojans }}</check_trojans>
    <check_dev>{{ .rootcheck.check_dev }}</check_dev>
    <check_sys>{{ .rootcheck.check_sys }}</check_sys>
    <check_pids>{{ .rootcheck.check_pids }}</check_pids>
    <check_ports>{{ .rootcheck.check_ports }}</check_ports>
    <check_if>{{ .rootcheck.check_if }}</check_if>
    <frequency>{{ .rootcheck.frequency }}</frequency>
    <rootkit_files>etc/shared/rootkit_files.txt</rootkit_files>
    <rootkit_trojans>etc/shared/rootkit_trojans.txt</rootkit_trojans>
    <skip_nfs>yes</skip_nfs>
  </rootcheck>

  <!-- System inventory -->
  <wodle name="syscollector">
    <disabled>{{ .inventory.disabled }}</disabled>
    <interval>{{ .inventory.interval }}</interval>
    <scan_on_start>{{ .inventory.scan_on_start }}</scan_on_start>
    <hardware>{{ .inventory.hardware }}</hardware>
    <os>{{ .inventory.os }}</os>
    <network>{{ .inventory.network }}</network>
    <packages>{{ .inventory.packages }}</packages>
    <ports all="yes">{{ .inventory.ports }}</ports>
    <processes>{{ .inventory.processes }}</processes>
    <users>no</users>
    <groups>no</groups>
    <services>no</services>
    <browser_extensions>no</browser_extensions>
    <synchronization>
      <max_eps>10</max_eps>
    </synchronization>
  </wodle>

  <!-- Security configuration assessment -->
  <sca>
    <enabled>{{ .sca.enabled }}</enabled>
    <scan_on_start>{{ .sca.scan_on_start }}</scan_on_start>
    <interval>{{ .sca.interval }}</interval>
    <skip_nfs>{{ .sca.skip_nfs }}</skip_nfs>
{{- if .sca.policies }}
    <policies>
{{- range .sca.policies }}
      <policy>{{ . }}</policy>
{{- end }}
    </policies>
{{- end }}
  </sca>

  <!-- File integrity monitoring -->
  <syscheck>
    <disabled>{{ .fim.disabled }}</disabled>
    <frequency>{{ .fim.frequency }}</frequency>
    <scan_on_start>{{ .fim.scan_on_start }}</scan_on_start>
{{- range .fim.directories }}
    <directories realtime="{{ .realtime }}" report_changes="{{ .report_changes }}" check_all="{{ .check_all }}"
{{- if .restrict }} restrict="{{ .restrict }}"{{ end }}
{{- if .tags }} tags="{{ .tags }}"{{ end }}
{{- if .recursion_level }} recursion_level="{{ .recursion_level }}"{{ end }}>{{ .path }}</directories>
{{- end }}
{{- range .fim.ignore }}
    <ignore>{{ . }}</ignore>
{{- end }}
{{- range .fim.ignore_sregex }}
    <ignore type="sregex">{{ . }}</ignore>
{{- end }}
{{- range .fim.nodiff }}
    <nodiff>{{ . }}</nodiff>
{{- end }}
{{- range .fim.nodiff_sregex }}
    <nodiff type="sregex">{{ . }}</nodiff>
{{- end }}
    <skip_nfs>yes</skip_nfs>
    <skip_dev>yes</skip_dev>
    <skip_proc>yes</skip_proc>
    <skip_sys>yes</skip_sys>
    <process_priority>{{ .fim.process_priority }}</process_priority>
    <max_eps>{{ .fim.max_eps }}</max_eps>
    <file_limit>
      <enabled>yes</enabled>
      <entries>{{ .fim.file_limit }}</entries>
    </file_limit>
    <synchronization>
      <enabled>{{ .fim.sync_enabled }}</enabled>
      <interval>{{ .fim.sync_interval }}</interval>
      <max_eps>{{ .fim.sync_max_eps }}</max_eps>
    </synchronization>
  </syscheck>

  <!-- Log analysis: host journal (Home Assistant OS) -->
{{- range .journal.localfiles }}
  <localfile>
    <location>journald</location>
    <log_format>journald</log_format>
{{- range .filters }}
    <filter field="{{ .field }}"{{ if .ignore_if_missing }} ignore_if_missing="yes"{{ end }}>{{ .pattern }}</filter>
{{- end }}
  </localfile>
{{- end }}

  <!-- Log analysis: files -->
{{- range .files }}
  <localfile>
    <location>{{ .path }}</location>
    <log_format>{{ .format }}</log_format>
{{- if .only_future_events }}
    <only-future-events>{{ .only_future_events }}</only-future-events>
{{- end }}
{{- if .ignore }}
    <ignore type="PCRE2">{{ .ignore }}</ignore>
{{- end }}
{{- if .restrict }}
    <restrict type="PCRE2">{{ .restrict }}</restrict>
{{- end }}
{{- if .exclude }}
    <exclude>{{ .exclude }}</exclude>
{{- end }}
{{- if .age }}
    <age>{{ .age }}</age>
{{- end }}
  </localfile>
{{- end }}

  <!-- Log analysis: commands -->
{{- range .commands }}
  <localfile>
    <log_format>{{ .format }}</log_format>
    <command>{{ .command }}</command>
{{- if .alias }}
    <alias>{{ .alias }}</alias>
{{- end }}
    <frequency>{{ .frequency }}</frequency>
  </localfile>
{{- end }}

{{- if .labels }}

  <labels>
{{- range .labels }}
    <label key="{{ .key }}">{{ .value }}</label>
{{- end }}
  </labels>
{{- end }}

  <!-- Active response -->
  <active-response>
    <disabled>{{ .active_response.disabled }}</disabled>
    <ca_store>etc/wpk_root.pem</ca_store>
    <ca_verification>yes</ca_verification>
  </active-response>

  <logging>
    <log_format>plain</log_format>
  </logging>
</ossec_config>
