# Renders ossec.conf from the template context built by ctx.jq.
#
#   jq -r -f ossec.conf.jq context.json > ossec.conf
#
# Values are written out exactly as given. Wazuh's configuration reader does not
# decode XML entities (&lt; stays "&lt;"), so nothing here is escaped: validate.jq
# has already refused the few characters that cannot be represented.
#
# Written in jq, not as a text template, so the image needs no templating binary:
# the only tool involved is jq, which the validator and the context builder use too.

def present: . != null and . != "";
def t($indent; $name; $value):
  (" " * $indent) + "<" + $name + ">" + ($value | tostring) + "</" + $name + ">";

. as $c
| [
  "<!--",
  "  Generated by the Home Assistant \"Wazuh Agent\" app from its Configuration tab.",
  "  Do not edit: this file is rewritten every time the app starts.",
  "  To add anything this app has no option for, put extra <ossec_config> blocks",
  "  in ossec_extra.conf in the app's configuration folder.",
  "-->",
  "<ossec_config>",
  "  <client>",
  ($c.servers[] |
    "    <server>",
    t(6; "address"; .address),
    t(6; "port"; .port),
    t(6; "protocol"; .protocol),
    t(6; "max_retries"; $c.client.max_retries),
    t(6; "retry_interval"; $c.client.retry_interval),
    "    </server>"),
  (if ($c.client.config_profile | present) then t(4; "config-profile"; $c.client.config_profile) else empty end),
  t(4; "notify_time"; $c.client.notify_time),
  t(4; "time-reconnect"; $c.client.time_reconnect),
  t(4; "auto_restart"; $c.client.auto_restart),
  t(4; "crypto_method"; $c.client.crypto_method),
  "    <enrollment>",
  t(6; "enabled"; $c.enrollment.enabled),
  (if ($c.enrollment.address | present) then t(6; "manager_address"; $c.enrollment.address) else empty end),
  t(6; "port"; $c.enrollment.port),
  t(6; "agent_name"; $c.enrollment.agent_name),
  (if ($c.enrollment.groups | present) then t(6; "groups"; $c.enrollment.groups) else empty end),
  (if ($c.enrollment.ca_path | present) then t(6; "server_ca_path"; $c.enrollment.ca_path) else empty end),
  (if ($c.enrollment.certificate_path | present) then
     t(6; "agent_certificate_path"; $c.enrollment.certificate_path),
     t(6; "agent_key_path"; $c.enrollment.key_path)
   else empty end),
  (if $c.enrollment.use_password then t(6; "authorization_pass_path"; "etc/authd.pass") else empty end),
  t(6; "delay_after_enrollment"; $c.enrollment.delay),
  t(6; "use_source_ip"; $c.enrollment.use_source_ip),
  "    </enrollment>",
  "  </client>",
  "",
  "  <client_buffer>",
  t(4; "disabled"; $c.buffer.disabled),
  t(4; "queue_size"; $c.buffer.queue_size),
  t(4; "events_per_second"; $c.buffer.events_per_second),
  "  </client_buffer>",
  "",
  "  <!-- Policy monitoring -->",
  "  <rootcheck>",
  t(4; "disabled"; $c.rootcheck.disabled),
  t(4; "check_files"; $c.rootcheck.check_files),
  t(4; "check_trojans"; $c.rootcheck.check_trojans),
  t(4; "check_dev"; $c.rootcheck.check_dev),
  t(4; "check_sys"; $c.rootcheck.check_sys),
  t(4; "check_pids"; $c.rootcheck.check_pids),
  t(4; "check_ports"; $c.rootcheck.check_ports),
  t(4; "check_if"; $c.rootcheck.check_if),
  t(4; "frequency"; $c.rootcheck.frequency),
  t(4; "rootkit_files"; "etc/shared/rootkit_files.txt"),
  t(4; "rootkit_trojans"; "etc/shared/rootkit_trojans.txt"),
  t(4; "skip_nfs"; "yes"),
  "  </rootcheck>",
  "",
  "  <!-- System inventory -->",
  "  <wodle name=\"syscollector\">",
  t(4; "disabled"; $c.inventory.disabled),
  t(4; "interval"; $c.inventory.interval),
  t(4; "scan_on_start"; $c.inventory.scan_on_start),
  t(4; "hardware"; $c.inventory.hardware),
  t(4; "os"; $c.inventory.os),
  t(4; "network"; $c.inventory.network),
  t(4; "packages"; $c.inventory.packages),
  "    <ports all=\"yes\">\($c.inventory.ports)</ports>",
  t(4; "processes"; $c.inventory.processes),
  t(4; "users"; "no"),
  t(4; "groups"; "no"),
  t(4; "services"; "no"),
  t(4; "browser_extensions"; "no"),
  "    <synchronization>",
  t(6; "max_eps"; 10),
  "    </synchronization>",
  "  </wodle>",
  "",
  "  <!-- Security configuration assessment -->",
  "  <sca>",
  t(4; "enabled"; $c.sca.enabled),
  t(4; "scan_on_start"; $c.sca.scan_on_start),
  t(4; "interval"; $c.sca.interval),
  t(4; "skip_nfs"; $c.sca.skip_nfs),
  (if ($c.sca.policies | length) > 0 then
     "    <policies>",
     ($c.sca.policies[] | t(6; "policy"; .)),
     "    </policies>"
   else empty end),
  "  </sca>",
  "",
  "  <!-- File integrity monitoring -->",
  "  <syscheck>",
  t(4; "disabled"; $c.fim.disabled),
  t(4; "frequency"; $c.fim.frequency),
  t(4; "scan_on_start"; $c.fim.scan_on_start),
  ($c.fim.directories[] |
    "    <directories realtime=\"\(.realtime)\" report_changes=\"\(.report_changes)\" check_all=\"\(.check_all)\""
    + (if (.restrict | present) then " restrict=\"\(.restrict)\"" else "" end)
    + (if (.tags | present) then " tags=\"\(.tags)\"" else "" end)
    # 0 is a valid depth (the directory itself only), so test for null, not for truthiness.
    + (if .recursion_level != null then " recursion_level=\"\(.recursion_level)\"" else "" end)
    + ">\(.path)</directories>"),
  ($c.fim.ignore[] | t(4; "ignore"; .)),
  ($c.fim.ignore_sregex[] | "    <ignore type=\"sregex\">\(.)</ignore>"),
  ($c.fim.nodiff[] | t(4; "nodiff"; .)),
  ($c.fim.nodiff_sregex[] | "    <nodiff type=\"sregex\">\(.)</nodiff>"),
  t(4; "skip_nfs"; "yes"),
  t(4; "skip_dev"; "yes"),
  t(4; "skip_proc"; "yes"),
  t(4; "skip_sys"; "yes"),
  t(4; "process_priority"; $c.fim.process_priority),
  t(4; "max_eps"; $c.fim.max_eps),
  "    <file_limit>",
  t(6; "enabled"; "yes"),
  t(6; "entries"; $c.fim.file_limit),
  "    </file_limit>",
  "    <synchronization>",
  t(6; "enabled"; $c.fim.sync_enabled),
  t(6; "interval"; $c.fim.sync_interval),
  t(6; "max_eps"; $c.fim.sync_max_eps),
  "    </synchronization>",
  "  </syscheck>",
  "",
  "  <!-- Log analysis: host journal (Home Assistant OS) -->",
  ($c.journal.localfiles[] |
    "  <localfile>",
    t(4; "location"; "journald"),
    t(4; "log_format"; "journald"),
    (.filters[] |
      "    <filter field=\"\(.field)\""
      + (if .ignore_if_missing then " ignore_if_missing=\"yes\"" else "" end)
      + ">\(.pattern)</filter>"),
    "  </localfile>"),
  "",
  "  <!-- Log analysis: files -->",
  ($c.files[] |
    "  <localfile>",
    t(4; "location"; .path),
    t(4; "log_format"; .format),
    (if .only_future_events != null then t(4; "only-future-events"; .only_future_events) else empty end),
    (if (.ignore | present) then "    <ignore type=\"PCRE2\">\(.ignore)</ignore>" else empty end),
    (if (.restrict | present) then "    <restrict type=\"PCRE2\">\(.restrict)</restrict>" else empty end),
    (if (.exclude | present) then t(4; "exclude"; .exclude) else empty end),
    (if (.age | present) then t(4; "age"; .age) else empty end),
    "  </localfile>"),
  "",
  "  <!-- Log analysis: commands -->",
  ($c.commands[] |
    "  <localfile>",
    t(4; "log_format"; .format),
    t(4; "command"; .command),
    (if (.alias | present) then t(4; "alias"; .alias) else empty end),
    t(4; "frequency"; .frequency),
    "  </localfile>"),
  (if ($c.labels | length) > 0 then
     "",
     "  <labels>",
     ($c.labels[] | "    <label key=\"\(.key)\">\(.value)</label>"),
     "  </labels>"
   else empty end),
  "",
  "  <!-- Active response -->",
  "  <active-response>",
  t(4; "disabled"; $c.active_response.disabled),
  t(4; "ca_store"; "etc/wpk_root.pem"),
  t(4; "ca_verification"; "yes"),
  "  </active-response>",
  "",
  "  <logging>",
  t(4; "log_format"; "plain"),
  "  </logging>",
  "</ossec_config>"
] | join("\n")
