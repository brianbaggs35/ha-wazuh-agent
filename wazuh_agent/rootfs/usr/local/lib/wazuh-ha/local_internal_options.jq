# Renders local_internal_options.conf from the template context built by ctx.jq.
#
#   jq -r -f local_internal_options.jq context.json > local_internal_options.conf

[
  "# Generated by the Home Assistant \"Wazuh Agent\" app. Rewritten on every start.",
  "# Put additional settings in local_internal_options_extra.conf in the app's",
  "# configuration folder.",
  "",
  "# Debug verbosity: 0 = off, 1 = debug, 2 = verbose debug.",
  "agent.debug=\(.options_file.debug_level)",
  "execd.debug=\(.options_file.debug_level)",
  "logcollector.debug=\(.options_file.debug_level)",
  "syscheck.debug=\(.options_file.debug_level)",
  "wazuh_modules.debug=\(.options_file.debug_level)",
  "",
  "# Whether the manager may push command-execution settings to this agent",
  "# (centralised agent.conf). Off unless explicitly enabled in the app options.",
  "logcollector.remote_commands=\(.options_file.remote_commands)",
  "wazuh_command.remote_commands=\(.options_file.remote_commands)",
  "sca.remote_commands=\(.options_file.remote_commands)"
] | join("\n")
