{
  "name": "wazuh-agent-status",
  "version": "1.0.1",
  "private": true,
  "description": "Read-only status page for the Wazuh Agent Home Assistant app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check src *.ts *.json"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "vue": "3.5.44",
    "vuetify": "4.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
